{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@arpitpatel1771/drive-sync": ["./src/index.ts"],
      "@arpitpatel1771/drive-sync/react": ["./src/react/index.ts"],
      "@arpitpatel1771/drive-sync/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "*.ts"]
}
